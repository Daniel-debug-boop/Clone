config_version=5
[application]
config/name="Japan Open World"
run/main_scene="res://scenes/main_world.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/vsync/vsync_mode=1
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
rendering_device/driver="vulkan"
rendering_device/fallback_to_opengl3=true
textures/defaults/use_mipmap_filter=false
textures/defaults/anisotropic_filtering_level=4
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
environment/defaults/defaults_color=Color(0.05, 0.07, 0.1, 1)
environment/ssao/quality=2
environment/ssao/blur_passes=2
environment/ssil/quality=2
environment/ssil/blur_passes=2
environment/sdfgi/enabled=false
[physics]
3d/default_gravity=9.8
3d/default_linear_damp=0.0
3d/default_angular_damp=0.0
[debug]
script/warnings/undeclared=1
script/warnings/unsafe_method_access=1
script/warnings/unsafe_property_access=1