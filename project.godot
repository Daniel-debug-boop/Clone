; Engine configuration file.
; Japan Open World - Godot 4.6.3
config_version=5

[application]

config/name="Japan Open World"
config/description="An open-world exploration game set in central Kyoto, built from real geodata."
config/version="0.1.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.05, 0.07, 0.1, 1)
boot_splash/show_image=false

[autoload]

SettingsManager="*res://scripts/autoload/settings_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/vsync/vsync_mode=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

