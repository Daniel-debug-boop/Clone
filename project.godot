[physics]

3d/default_gravity=9.8
3d/default_linear_damp=0.05
3d/default_angular_damp=0.1
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.05, 0.07, 0.1, 1)
environment/ssao/quality=2
environment/ssao/blur_passes=2
environment/ssil/quality=2
environment/sdfgi/enabled=false
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
occlusion_culling/use_occlusion_culling=true
global_illumination/gi/use_half_resolution=false
driver/depth_prepass/enable=true
limits/opengl/max_lights_per_object=16

[physics_layers]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="props"
3d_physics/layer_4="triggers"

[filesystem]

import/blender/enabled=false
import/fbx2gltf/enabled=false

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/return_value_discarded=0
